"""
FastAPI server untuk RAG service IKU.

Endpoint:
  - POST /v1/answer: Jawab pertanyaan menggunakan RAG + kalkulator IKU
  - GET /health: Health check
"""

import os
import re
import sys
from pathlib import Path

import openai
from fastapi import FastAPI, Header, HTTPException
from fastapi.responses import JSONResponse

# Setup path untuk import internal modules
PROJECT_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(PROJECT_ROOT / "src" / "retrieval"))
sys.path.insert(0, str(PROJECT_ROOT / "src" / "generation"))

from answer import Chatbot  # noqa: E402
from prompt import SYSTEM_PROMPT, build_user_message  # noqa: E402

# Inisialisasi Chatbot sekali saat startup (bukan per-request)
bot: Chatbot | None = None


def get_chatbot() -> Chatbot:
    """Lazy initialization Chatbot."""
    global bot
    if bot is None:
        print("Initializing Chatbot...")
        bot = Chatbot()
        print(f"Chatbot ready (model: {bot.model})")
    return bot


def detect_intent(question: str) -> str:
    """
    Detect intent pertanyaan menggunakan LLM.
    Returns: "definisi", "formula", atau "data"
    """
    intent_system_prompt = """Anda adalah classifier pertanyaan. Tugas Anda mengklasifikasikan pertanyaan pengguna menjadi satu dari tiga kategori:
- "definisi": Pertanyaan tentang definisi atau penjelasan IKU
- "formula": Pertanyaan tentang formula/rumus perhitungan IKU
- "data": Pertanyaan yang meminta data/spreadsheet dari kampus (kata kunci: nilai, jumlah, berapa, data kampus, PT, fakultas, program studi)

Format jawaban HANYA: satu kata tanpa teks tambahan (definisi/formula/data)."""

    try:
        messages = [
            {"role": "system", "content": intent_system_prompt},
            {"role": "user", "content": f"Pertanyaan: {question}"},
        ]
        response = bot.client.chat.completions.create(
            model=bot.model,
            messages=messages,
            temperature=0,
            max_tokens=10,
        )
        intent = response.choices[0].message.content.strip().lower()
        if intent in ["definisi", "formula", "data"]:
            return intent
        return "definisi"
    except Exception:
        return "definisi"


