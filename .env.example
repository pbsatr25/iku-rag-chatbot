# Hanya dibutuhkan untuk tahap parsing (src/parsing/parse_pdf.py).
# Ambil API key di https://cloud.llamaindex.ai -> API Keys
LLAMA_CLOUD_API_KEY=

# Tahap generation (LLM), lewat format OpenAI. Pilih SATU penyedia: aktifkan satu blok,
# jadikan komentar blok lainnya. Kode tidak perlu diubah saat berganti penyedia.

# --- Groq (dipakai saat ini untuk testing) ---
# API key (diawali gsk_) dari https://console.groq.com -> API Keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# --- Gemini (cadangan) ---
# API key dari https://aistudio.google.com
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_API_KEY=

# Batas tunggu per panggilan LLM (detik) dan jumlah percobaan ulang otomatis
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Demo Streamlit (src/ui/app_streamlit.py). WAJIB isi kata sandi bila dibuka lewat tunnel.
# Disarankan memakai API key LLM terpisah untuk demo agar jatah evaluasi tidak ikut habis.
DEMO_PASSWORD=
DEMO_MAKS_PERTANYAAN=15

# FastAPI RAG Service (src/api/app.py) - untuk autentikasi internal
RAG_SERVICE_TOKEN=your-secret-token-here
